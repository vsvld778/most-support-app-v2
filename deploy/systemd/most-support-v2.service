[Unit]
Description=Most Support V2 application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=mostv2
Group=mostv2
WorkingDirectory=/opt/most-support-app-v2/backend
EnvironmentFile=/etc/most-support-v2/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/most-support-app-v2/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 3 --threads 2 --timeout 60 --max-requests 1200 --max-requests-jitter 100 --error-logfile -
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/most-support-v2
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
